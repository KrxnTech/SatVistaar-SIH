# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
CLIENT_URL=http://localhost:5173

# API Prefix Configuration
API_PREFIX=/api/v1

# Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# Python Preprocessing Service Configuration
PREPROCESSING_SERVICE_URL=http://localhost:5001
PREPROCESSING_TIMEOUT_MS=5000

# ML Inference / VLM Mode Configuration
ML_MODE=mock # 'real' or 'mock'

# VLM Provider Configurations
MODEL_PROVIDER=auto # 'auto', 'groq', 'ollama', or 'mock'
MODEL_ROUTER_MODE=priority # 'priority' or 'fallback'
VLM_TIMEOUT_MS=30000

# Groq VLM Configuration
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Ollama VLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2-vl
