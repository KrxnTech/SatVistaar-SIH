# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
CLIENT_URL=http://localhost:5173

# API Prefix Configuration
API_PREFIX=/api/v1

# Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# Python Preprocessing Service Configuration
PREPROCESSING_SERVICE_URL=http://localhost:5001
PREPROCESSING_TIMEOUT_MS=5000

# ML Inference Service Configuration (For ML Team integration)
ML_SERVICE_URL=http://localhost:5002
ML_SERVICE_TIMEOUT_MS=10000
ML_MODE=mock
