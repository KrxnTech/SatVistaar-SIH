# ==========================================
# SatVistaar Docker Environment Configuration
# ==========================================

# Ports
FRONTEND_PORT=80
BACKEND_PORT=5000
PREPROCESSING_PORT=5001

# Application URLs
CLIENT_URL=http://localhost
API_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=satvistaar_production_secret_key_change_me_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=satvistaar_production_cookie_secret_2026

# Upload Configuration
MAX_UPLOAD_SIZE_MB=100

# Preprocessing Service
PREPROCESSING_TIMEOUT_MS=15000

# VLM Inference Mode ('real' or 'mock')
ML_MODE=real

# VLM Provider ('auto', 'groq', 'ollama', 'mock')
MODEL_PROVIDER=auto
MODEL_ROUTER_MODE=priority
VLM_TIMEOUT_MS=30000

# Groq Cloud Provider (Recommended for fast GPU VLM inference)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Local Ollama Provider (If running Ollama on host machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2-vl
